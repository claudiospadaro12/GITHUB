+def _changes_from_snapshots(snapshots: list[dict]) -> dict:
+    """{ticker: {giorno: var% close-su-close del GIORNO}} ricavata dagli snapshot stessi.
+    'last_close' dello snapshot del giorno D e' la chiusura del giorno precedente, quindi la
+    variazione del giorno D = last_close(snapshot D+1) / last_close(snapshot D) - 1. Stessa fonte
+    e stessa definizione di bias (chiusure giornaliere): nessun download esterno, nessun problema
+    di fuso orario fra FX/futures/indici. L'ultimo snapshot non ha il giorno dopo: quel giorno
+    resta a yfinance."""
+    snaps = sorted(snapshots, key=lambda s: s["date"])
+    out: dict[str, dict] = {}
+    for a, b in zip(snaps, snaps[1:]):
+        for g, lst in a.get("instruments", {}).items():
+            nxt = {i.get("ticker"): i for i in b.get("instruments", {}).get(g, [])}
+            for inst in lst:
+                tk = inst.get("ticker"); j = nxt.get(tk)
+                if not tk or not j: continue
+                c0, c1 = inst.get("last_close"), j.get("last_close")
+                if c0 and c1:
+                    out.setdefault(tk, {})[a["date"]] = (c1 / c0 - 1.0) * 100.0
+    return out
+
