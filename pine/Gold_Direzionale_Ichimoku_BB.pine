//@version=5
// =====================================================================
//  Gold Direzionale — Ichimoku + Bollinger (Claudio)
//  INDICATORE per trading MANUALE: segnala LONG/SHORT direzionali
//  solo quando il trend e' forte e le bande sono espanse (no squeeze).
//
//  Filtri (gli stessi che nei backtest hanno alzato la qualita'):
//    - Nuvola Kumo : prezzo sopra (long) / sotto (short) la nuvola
//    - ADX         : entra solo se il trend e' forte (ADX > soglia)
//    - Espansione  : entra solo con bande ESPANSE (non in squeeze)
//    - Cooldown    : niente segnali troppo ravvicinati (anti-rumore)
//
//  NB: un indicatore NON elimina i falsi segnali. Riduce solo la
//      frequenza dei segnali a bassa probabilita'. Lo STOP LOSS resta
//      obbligatorio su OGNI ingresso.
// =====================================================================
indicator("Gold Direzionale - Ichimoku + BB (Claudio)", overlay=true, max_labels_count=500)

// ---------------- INPUT: Ichimoku (Donchian, periodi tuoi) -----------
tenkanLen  = input.int(7,  "Tenkan",       group="Ichimoku")
kijunLen   = input.int(22, "Kijun",        group="Ichimoku")
senkouBLen = input.int(44, "Senkou B",     group="Ichimoku")
disp       = input.int(26, "Displacement", group="Ichimoku")

// ---------------- INPUT: Bollinger -----------------------------------
bbLen  = input.int(20,   "BB Length",     group="Bollinger")
bbMult = input.float(2.0,"BB Deviazioni", group="Bollinger")

// ---------------- INPUT: Filtri --------------------------------------
useKumo      = input.bool(true,  "Filtro Nuvola Kumo",              group="Filtri")
useADX       = input.bool(true,  "Filtro ADX (trend forte)",        group="Filtri")
adxLen       = input.int(14,     "ADX Length",                      group="Filtri")
adxMin       = input.float(22,   "ADX soglia minima",               group="Filtri")
useExp       = input.bool(true,  "Filtro Espansione BB (no squeeze)",group="Filtri")
bbWidthMaLen = input.int(50,     "Media BB Width",                  group="Filtri")
squeezeFactor= input.float(0.8,  "Fattore squeeze",                 group="Filtri")

// ---------------- INPUT: Comportamento -------------------------------
minBars   = input.int(3, "Min candele tra segnali", minval=1, group="Comportamento")
showLong  = input.bool(true, "Mostra LONG",  group="Comportamento")
showShort = input.bool(true, "Mostra SHORT", group="Comportamento")

// ---------------- ICHIMOKU (midpoint Donchian) -----------------------
donchian(len) => math.avg(ta.highest(len), ta.lowest(len))
tenkan  = donchian(tenkanLen)
kijun   = donchian(kijunLen)
senkouA = math.avg(tenkan, kijun)
senkouB = donchian(senkouBLen)

// Nuvola alla posizione del prezzo corrente (calcolata disp barre fa)
spanA = senkouA[disp]
spanB = senkouB[disp]
cloudTop = math.max(spanA, spanB)
cloudBot = math.min(spanA, spanB)
aboveCloud = close > cloudTop
belowCloud = close < cloudBot

// ---------------- BOLLINGER + ESPANSIONE -----------------------------
basis   = ta.sma(close, bbLen)
dev     = bbMult * ta.stdev(close, bbLen)
upperBB = basis + dev
lowerBB = basis - dev
bbWidth   = upperBB - lowerBB
bbWidthMa = ta.sma(bbWidth, bbWidthMaLen)
expanded  = bbWidth > bbWidthMa * squeezeFactor   // true = NON in squeeze

// ---------------- ADX ------------------------------------------------
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
strongTrend = adx > adxMin

// ---------------- CONDIZIONI FILTRO ----------------------------------
adxOk       = not useADX  or strongTrend
expOk       = not useExp  or expanded
kumoLongOk  = not useKumo or aboveCloud
kumoShortOk = not useKumo or belowCloud

// ---------------- TRIGGER: TK cross filtrato -------------------------
tkUp   = ta.crossover(tenkan, kijun)
tkDown = ta.crossunder(tenkan, kijun)

rawLong  = tkUp   and adxOk and expOk and kumoLongOk
rawShort = tkDown and adxOk and expOk and kumoShortOk

// Cooldown: almeno minBars dall'ultimo segnale (anti flip-flop)
var int lastSig = na
barsSince = na(lastSig) ? minBars + 1 : bar_index - lastSig
canFire   = barsSince >= minBars

longSig  = showLong  and rawLong  and canFire
shortSig = showShort and rawShort and canFire
if longSig or shortSig
    lastSig := bar_index

// ---------------- PLOT segnali ---------------------------------------
plotshape(longSig,  title="LONG",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green,0), text="LONG",  textcolor=color.white, size=size.small)
plotshape(shortSig, title="SHORT", style=shape.labeldown, location=location.abovebar, color=color.new(color.red,0),   text="SHORT", textcolor=color.white, size=size.small)

// ---------------- PLOT riferimenti visivi ----------------------------
pA = plot(senkouA, "Senkou A", color=color.new(color.green,70), offset=disp)
pB = plot(senkouB, "Senkou B", color=color.new(color.red,70),   offset=disp)
fill(pA, pB, color=color.new(color.gray,90), title="Kumo")
plot(tenkan,  "Tenkan",   color=color.new(color.blue,0))
plot(kijun,   "Kijun",    color=color.new(color.orange,0))
plot(basis,   "BB Basis", color=color.new(color.gray,40))
plot(upperBB, "BB Upper", color=color.new(color.teal,40))
plot(lowerBB, "BB Lower", color=color.new(color.teal,40))

// Sfondo: rosso tenue quando in squeeze (NON operare)
bgcolor(useExp and not expanded ? color.new(color.red, 92) : na, title="Squeeze")

// ---------------- ALERT (per ingresso manuale) -----------------------
alertcondition(longSig,  title="LONG oro",  message="ORO: segnale LONG direzionale")
alertcondition(shortSig, title="SHORT oro", message="ORO: segnale SHORT direzionale")
