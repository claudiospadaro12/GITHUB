//@version=5
// ═══════════════════════════════════════════════════════════════════════════════
// ABTG Band Riding + 3 EMA Signal — v1.2
// Autore: Claudio (con Claude)
// Data:   31/05/2026
//
// CHANGELOG v1.1 → v1.2:
//   + K COEFFICIENT ABTG AUTOMATICO: tutte le soglie in punti vengono scalate
//     in base allo strumento (stesso K di ORB_Indicator_V05)
//       - Indici/Oro/SPX/NAS = 1.0
//       - Forex non-JPY      = 0.0001
//       - Forex JPY          = 0.01
//     Effetto: un solo set di valori di input funziona su tutti gli strumenti.
//   + DISPLAY SEMPLIFICATO: solo "LONG" e "SHORT" come frecce, nessuna sigla
//     BR/EMA. Logicamente i due segnali sono ancora indipendenti dentro, ma a
//     schermo vedi un'unica freccia per direzione.
//   + Anti-doppione GLOBALE: long e short sono unici regardless of origine.
//
// ═══════════════════════════════════════════════════════════════════════════════
// >>> QUESTO FILE E' LA FONTE DEL PORTING IN MT5.
// Committato nel repo il 17/09/2026 (classe 402/403 -- vedi
// backtest_pipeline/CHECKLIST_RIGA_DI_LANCIO.md): il porting
// mql5/Indicators/ABTG_SuperEMA_Riding.mq5 dichiara di essere fedele a QUESTO
// sorgente riga per riga, e senza il sorgente nel repo quella fedelta' non era
// ne' verificabile ne' RI-verificabile da nessuno. Incollato verbatim da
// Claudio in chat, non modificato.
// ═══════════════════════════════════════════════════════════════════════════════

indicator("ABTG BR+EMA — v1.2", 
         shorttitle="ABTG v1.2",
         overlay=true, 
         max_labels_count=500,
         max_lines_count=100)

// ═══════════════════════════════════════════════════════════════════════════════
// 1. AUTO-DETECT STRUMENTO + K COEFFICIENT
// ═══════════════════════════════════════════════════════════════════════════════
ticker_upper = str.upper(syminfo.ticker)
isGold     = str.contains(ticker_upper, "XAU")
isForexRaw = syminfo.type == "forex"
isIndexRaw = syminfo.type == "index" or syminfo.type == "futures"

indexKeywords = array.from("DAX","D30","D40","NAS","NDX","SPX","SP500","US500","US30","DJI","FTSE","UK100","CAC","NIK","STOXX","DE40","NQ100")
isIndexCFD = false
if syminfo.type == "cfd"
    for i = 0 to array.size(indexKeywords) - 1
        if str.contains(ticker_upper, array.get(indexKeywords, i))
            isIndexCFD := true
            break

isIndex = isIndexRaw or isIndexCFD
isForex = isForexRaw and not isGold and not isIndex

// Per K coefficient: forex JPY (qualsiasi pair con JPY) vs forex non-JPY
isForexJPY = isForex and str.contains(ticker_upper, "JPY")
isForexNonJPY = isForex and not isForexJPY

string category = isIndex ? "INDEX" : (isGold ? "GOLD" : (isForexJPY ? "FX_JPY" : (isForexNonJPY ? "FX" : "INDEX")))

// ═══════════════════════════════════════════════════════════════════════════════
// 2. INPUT
// ═══════════════════════════════════════════════════════════════════════════════

// --- Master ---
grpMaster = "═══ Master segnali ═══"
useBandRiding = input.bool(true, "Attiva Segnale Band Riding (Emiliano)", group=grpMaster)
useEMACross   = input.bool(true, "Attiva Segnale 3 EMA Cross (Paolo)",   group=grpMaster)

// --- K coefficient ---
grpK = "═══ K coefficient (ABTG) ═══"
useAutoK = input.bool(true, "K automatico in base a strumento", group=grpK,
     tooltip="Scala tutte le soglie in punti per lo strumento. " +
             "INDEX/GOLD: K=1.0 | FOREX non-JPY: K=0.0001 | FOREX JPY: K=0.01. " +
             "Disattiva per usare K manuale (sotto).")
manualK = input.float(1.0, "K manuale", minval=0.00001, step=0.0001, group=grpK)
overrideCategory = input.bool(false, "Sovrascrivi categoria rilevata", group=grpK)
manualCategory = input.string("INDEX", "Categoria manuale", 
     options=["INDEX","GOLD","FX","FX_JPY"], group=grpK)

effectiveCategory = overrideCategory ? manualCategory : category

// K effettivo
autoK = effectiveCategory == "FX" ? 0.0001 : effectiveCategory == "FX_JPY" ? 0.01 : 1.0

K = useAutoK ? autoK : manualK

// --- Bollinger Bands principale ---
grpBB = "═══ Bollinger Bands principale ═══"
bbLenIdx    = input.int(37,  "BB Period — Indici/Oro", minval=1, group=grpBB)
bbMultIdx   = input.float(3.0, "BB Deviation — Indici/Oro", minval=0.1, step=0.1, group=grpBB)
bbLenFx     = input.int(22,  "BB Period — Forex", minval=1, group=grpBB)
bbMultFx    = input.float(2.0, "BB Deviation — Forex", minval=0.1, step=0.1, group=grpBB)
bbSrc       = input.source(close, "BB Source", group=grpBB)
bbLineWidth = input.int(2, "Spessore linea BB", minval=1, maxval=5, group=grpBB)

isFxCategory = effectiveCategory == "FX" or effectiveCategory == "FX_JPY"
bbLen  = isFxCategory ? bbLenFx  : bbLenIdx
bbMult = isFxCategory ? bbMultFx : bbMultIdx

// --- BB Cross Dashboard ---
grpCross = "═══ BB Cross Dashboard ═══"
crossLenIdx  = input.int(37,  "BB Cross Period — Indici", minval=1, group=grpCross)
crossMultIdx = input.float(1.4, "BB Cross Deviation — Indici", minval=0.1, step=0.1, group=grpCross)
crossLenFx   = input.int(22,  "BB Cross Period — Forex", minval=1, group=grpCross)
crossMultFx  = input.float(2.0, "BB Cross Deviation — Forex", minval=0.1, step=0.1, group=grpCross)

crossLen  = isFxCategory ? crossLenFx  : crossLenIdx
crossMult = isFxCategory ? crossMultFx : crossMultIdx

// --- Slope (in "punti normalizzati": valore moltiplicato per K) ---
grpSlope = "═══ Slope BB (band riding) ═══"
slopeBars      = input.int(3, "Barre per calcolo slope", minval=1, group=grpSlope)
slopeMinPtsRaw = input.float(0.8, "Slope minimo (punti normalizzati)", minval=0.0, step=0.1, 
     group=grpSlope,
     tooltip="Valore unico per tutti gli strumenti. Verrà moltiplicato per K. " +
             "Su DAX/SP500 M15: 0.8 = 0.8 punti reali. " +
             "Su EURUSD: 0.8 × 0.0001 = 0.00008 reali (≈ 0.8 pip).")

// Soglia reale = valore input × K
slopeMinReal = slopeMinPtsRaw * K

// --- Espansione ---
grpExp = "═══ Espansione bande ═══"
expansionMinPct = input.float(0.0, "Espansione minima larghezza (%)", 
     minval=0.0, step=0.1, group=grpExp)

// --- ATR ---
grpATR = "═══ ATR — triplo filtro AND ═══"
useATR_A = input.bool(true, "Filtro A: ATR > sua media (regime)", group=grpATR)
atrLen     = input.int(14, "ATR Period", minval=1, group=grpATR)
atrAvgLen  = input.int(50, "ATR Average Period", minval=1, group=grpATR)

useATR_B = input.bool(true, "Filtro B: ATR > soglia (punti normalizzati)", group=grpATR)
atrMinAbsRaw = input.float(8.0, "ATR minimo (punti normalizzati)", minval=0.0, group=grpATR,
     tooltip="Valore unico per tutti gli strumenti. Moltiplicato per K internamente. " +
             "Su DAX/SP500: 8 = 8 punti reali. " +
             "Su EURUSD: 8 × 0.0001 = 0.0008 reali (≈ 8 pip).")
atrMinReal = atrMinAbsRaw * K

useATR_C = input.bool(true, "Filtro C: range candela > X × ATR", group=grpATR)
candleAtrMult = input.float(1.0, "Moltiplicatore X (range vs ATR)", 
     minval=0.1, step=0.1, group=grpATR)

// --- Conferma 2ª candela ---
grpConf = "═══ Conferma 2ª candela ═══"
useConfirm = input.bool(true, "Conferma 2ª candela (hard)", group=grpConf)

// --- Filtro HA (solo BR) ---
grpHA = "═══ Filtro Heikin Ashi (solo Band Riding) ═══"
useHA = input.bool(true, "No ombra contraria su 2 HA", group=grpHA)
haWickTolRaw = input.float(0.5, "Tolleranza ombra HA (punti normalizzati)", 
     minval=0.0, step=0.1, group=grpHA)
haWickTolReal = haWickTolRaw * K

// --- 3 EMA Paolo ---
grpEMA = "═══ 3 EMA — Paolo (9/21/50) ═══"
emaFastLen = input.int(9,  "EMA Fast",   minval=1, group=grpEMA)
emaMidLen  = input.int(21, "EMA Medium", minval=1, group=grpEMA)
emaSlowLen = input.int(50, "EMA Slow (trend giornata)", minval=1, group=grpEMA)
emaSlopeBars = input.int(3, "Barre per pendenza EMA Slow", minval=1, group=grpEMA)
emaSlopeMinRaw = input.float(0.2, "Pendenza minima EMA Slow (punti normalizzati)", 
     minval=0.0, step=0.1, group=grpEMA)
emaSlopeMinReal = emaSlopeMinRaw * K
emaShowOnChart = input.bool(true, "Mostra le 3 EMA sul grafico", group=grpEMA)

// --- Display ---
grpDisp = "═══ Display ═══"
showBB        = input.bool(true,  "Mostra BB principale", group=grpDisp)
showBBCross   = input.bool(false, "Mostra BB Cross Dashboard", group=grpDisp)
showInfoPanel = input.bool(true,  "Mostra pannello info", group=grpDisp)

// ═══════════════════════════════════════════════════════════════════════════════
// 3. CALCOLI
// ═══════════════════════════════════════════════════════════════════════════════

// --- BB principale ---
bbBasis = ta.sma(bbSrc, bbLen)
bbDev   = bbMult * ta.stdev(bbSrc, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = bbUpper - bbLower

// --- BB cross ---
crossBasis = ta.sma(bbSrc, crossLen)
crossDev   = crossMult * ta.stdev(bbSrc, crossLen)
crossUpper = crossBasis + crossDev
crossLower = crossBasis - crossDev

// --- Slope BB (valori in unità di prezzo reale) ---
upperSlope = bbUpper - bbUpper[slopeBars]
lowerSlope = bbLower - bbLower[slopeBars]

// --- Espansione ---
widthPrev   = bbWidth[1]
widthGrowth = widthPrev > 0 ? ((bbWidth - widthPrev) / widthPrev) * 100 : 0.0
isExpanding = bbWidth >= widthPrev * (1.0 + expansionMinPct / 100.0)

// --- ATR ---
atr    = ta.atr(atrLen)
atrAvg = ta.sma(atr, atrAvgLen)

atrFilterA = not useATR_A or atr > atrAvg
atrFilterB = not useATR_B or atr > atrMinReal
candleRange = high - low
atrFilterC = not useATR_C or candleRange > candleAtrMult * atr
atrAllPass = atrFilterA and atrFilterB and atrFilterC

// --- BB cross concordanza ---
crossLongOK  = close > crossBasis
crossShortOK = close < crossBasis

// --- Heikin Ashi ---
haClose = (open + high + low + close) / 4
var float haOpen = na
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))
haLowerWick = math.min(haOpen, haClose) - haLow
haUpperWick = haHigh - math.max(haOpen, haClose)
noLowerWick = haLowerWick <= haWickTolReal
noUpperWick = haUpperWick <= haWickTolReal
haFilterLong  = not useHA or (noLowerWick and noLowerWick[1])
haFilterShort = not useHA or (noUpperWick and noUpperWick[1])

// --- 3 EMA ---
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
emaSlowSlope = emaSlow - emaSlow[emaSlopeBars]

emaLongAligned  = emaFast > emaMid and emaMid > emaSlow
emaShortAligned = emaFast < emaMid and emaMid < emaSlow
emaSlopeLongOK  = emaSlowSlope >=  emaSlopeMinReal
emaSlopeShortOK = emaSlowSlope <= -emaSlopeMinReal
emaLongFresh  = emaLongAligned  and not emaLongAligned[1]
emaShortFresh = emaShortAligned and not emaShortAligned[1]

// ═══════════════════════════════════════════════════════════════════════════════
// 4. SEGNALE BAND RIDING
// ═══════════════════════════════════════════════════════════════════════════════
touchUpper = high >= bbUpper
touchLower = low  <= bbLower

slopeLongOK_BR  = upperSlope >=  slopeMinReal
slopeShortOK_BR = lowerSlope <= -slopeMinReal

rawLongBR  = touchUpper and slopeLongOK_BR  and isExpanding and crossLongOK  and atrAllPass and haFilterLong
rawShortBR = touchLower and slopeShortOK_BR and isExpanding and crossShortOK and atrAllPass and haFilterShort

confirmedLongBR  = useConfirm ? (rawLongBR[1]  and close > high[1] and close > open) : rawLongBR
confirmedShortBR = useConfirm ? (rawShortBR[1] and close < low[1]  and close < open) : rawShortBR

candidateLongBR  = useBandRiding and confirmedLongBR
candidateShortBR = useBandRiding and confirmedShortBR

// ═══════════════════════════════════════════════════════════════════════════════
// 5. SEGNALE 3 EMA CROSS
// ═══════════════════════════════════════════════════════════════════════════════
rawLongEMA  = emaLongFresh  and emaSlopeLongOK
rawShortEMA = emaShortFresh and emaSlopeShortOK

confirmedLongEMA  = useConfirm ? (rawLongEMA[1]  and close > high[1] and close > open) : rawLongEMA
confirmedShortEMA = useConfirm ? (rawShortEMA[1] and close < low[1]  and close < open) : rawShortEMA

candidateLongEMA  = useEMACross and confirmedLongEMA
candidateShortEMA = useEMACross and confirmedShortEMA

// ═══════════════════════════════════════════════════════════════════════════════
// 6. SEGNALE UNIFICATO + ANTI-DOPPIONE GLOBALE
// ═══════════════════════════════════════════════════════════════════════════════
candidateLong  = candidateLongBR  or candidateLongEMA
candidateShort = candidateShortBR or candidateShortEMA

var int lastRegime = 0   // 1=long, -1=short, 0=none
longSignal  = candidateLong  and lastRegime != 1
shortSignal = candidateShort and lastRegime != -1
if longSignal
    lastRegime := 1
if shortSignal
    lastRegime := -1

// ═══════════════════════════════════════════════════════════════════════════════
// 7. DISPLAY — solo LONG e SHORT, niente sigle
// ═══════════════════════════════════════════════════════════════════════════════

// --- BB ---
pUpper = plot(showBB ? bbUpper : na, "BB Upper", color=color.new(color.blue, 0), linewidth=bbLineWidth)
pBasis = plot(showBB ? bbBasis : na, "BB Basis", color=color.new(color.gray, 30))
pLower = plot(showBB ? bbLower : na, "BB Lower", color=color.new(color.blue, 0), linewidth=bbLineWidth)
fill(pUpper, pLower, color=color.new(color.blue, 92))

// --- BB cross ---
plot(showBBCross ? crossUpper : na, "Cross Upper", color=color.new(color.orange, 50), style=plot.style_circles)
plot(showBBCross ? crossLower : na, "Cross Lower", color=color.new(color.orange, 50), style=plot.style_circles)

// --- 3 EMA ---
plot(emaShowOnChart ? emaFast : na, "EMA 9",  color=color.new(color.purple, 0), linewidth=1)
plot(emaShowOnChart ? emaMid  : na, "EMA 21", color=color.new(color.green,  0), linewidth=1)
plot(emaShowOnChart ? emaSlow : na, "EMA 50", color=color.new(color.yellow, 0), linewidth=2)

// --- Frecce uniche ---
plotshape(longSignal,  title="LONG",  location=location.belowbar, 
     style=shape.triangleup,   size=size.normal, color=color.new(color.green, 0),
     text="LONG", textcolor=color.white)
plotshape(shortSignal, title="SHORT", location=location.abovebar, 
     style=shape.triangledown, size=size.normal, color=color.new(color.red, 0),
     text="SHORT", textcolor=color.white)

// --- Alerts ---
alertcondition(longSignal,  title="LONG",  message="ABTG LONG su {{ticker}} @ {{close}}")
alertcondition(shortSignal, title="SHORT", message="ABTG SHORT su {{ticker}} @ {{close}}")

// ═══════════════════════════════════════════════════════════════════════════════
// 8. PANNELLO INFO
// ═══════════════════════════════════════════════════════════════════════════════
if showInfoPanel and barstate.islast
    var table tbl = table.new(position.top_right, 2, 13, 
         bgcolor=color.new(color.black, 80), 
         border_width=1, border_color=color.gray)
    
    table.cell(tbl, 0, 0, "ABTG BR + 3EMA", bgcolor=color.new(color.orange, 0), 
         text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, "v1.2", bgcolor=color.new(color.orange, 0), 
         text_color=color.white, text_size=size.small)
    
    table.cell(tbl, 0, 1, "Categoria", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, effectiveCategory + (overrideCategory ? " (manual)" : " (auto)"), 
         text_color=color.yellow, text_size=size.small)
    
    table.cell(tbl, 0, 2, "K coefficient", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(K, "#.######") + (useAutoK ? " (auto)" : " (manual)"), 
         text_color=color.aqua, text_size=size.small)
    
    table.cell(tbl, 0, 3, "BB principale", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(bbLen) + " / " + str.tostring(bbMult), 
         text_color=color.white, text_size=size.small)
    
    table.cell(tbl, 0, 4, "ATR(" + str.tostring(atrLen) + ")", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(atr, "#.######"), text_color=color.white, text_size=size.small)
    
    table.cell(tbl, 0, 5, "Soglia ATR effettiva", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(atrMinReal, "#.######"), 
         text_color=color.gray, text_size=size.small)
    
    table.cell(tbl, 0, 6, "Filtri A/B/C", text_color=color.white, text_size=size.small)
    abc = (atrFilterA ? "✓" : "✗") + " " + (atrFilterB ? "✓" : "✗") + " " + (atrFilterC ? "✓" : "✗")
    table.cell(tbl, 1, 6, abc, text_color=atrAllPass ? color.green : color.red, text_size=size.small)
    
    table.cell(tbl, 0, 7, "Espansione", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 7, isExpanding ? "✓ +" + str.tostring(widthGrowth, "#.##") + "%" : "✗", 
         text_color=isExpanding ? color.green : color.red, text_size=size.small)
    
    table.cell(tbl, 0, 8, "Slope upper/lower", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 8, str.tostring(upperSlope, "#.######") + " / " + str.tostring(lowerSlope, "#.######"), 
         text_color=color.white, text_size=size.small)
    
    table.cell(tbl, 0, 9, "Soglia slope effettiva", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 9, "±" + str.tostring(slopeMinReal, "#.######"), 
         text_color=color.gray, text_size=size.small)
    
    table.cell(tbl, 0, 10, "Allineamento EMA", text_color=color.white, text_size=size.small)
    alignLbl = emaLongAligned ? "LONG (9>21>50)" : (emaShortAligned ? "SHORT (9<21<50)" : "MIXED")
    alignCol = emaLongAligned ? color.green : (emaShortAligned ? color.red : color.gray)
    table.cell(tbl, 1, 10, alignLbl, text_color=alignCol, text_size=size.small)
    
    table.cell(tbl, 0, 11, "Ultimo regime", text_color=color.white, text_size=size.small)
    regimeLbl = lastRegime == 1 ? "LONG" : (lastRegime == -1 ? "SHORT" : "—")
    regimeCol = lastRegime == 1 ? color.green : (lastRegime == -1 ? color.red : color.gray)
    table.cell(tbl, 1, 11, regimeLbl, text_color=regimeCol, text_size=size.small)
    
    brEmaLbl = (useBandRiding ? "BR" : "") + (useBandRiding and useEMACross ? "+" : "") + (useEMACross ? "EMA" : "")
    if brEmaLbl == ""
        brEmaLbl := "OFF"
    table.cell(tbl, 0, 12, "Origini attive", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 12, brEmaLbl, text_color=color.yellow, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// FINE
// ═══════════════════════════════════════════════════════════════════════════════
