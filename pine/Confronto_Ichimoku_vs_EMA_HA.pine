//@version=5
// =====================================================================
//  CONFRONTO INGRESSI — Ichimoku-filtro+regime  VS  EMA9/21+HeikinAshi
//  (Claudio) — BACKTEST oggettivo, apples-to-apples.
//
//  L'UNICA cosa che cambia tra le due modalita' e' l'INGRESSO.
//  Rischio, sessione, uscita (SL/TP ad ATR), costi, periodo: IDENTICI.
//  Cosi' i numeri dicono quale ENTRATA e' migliore, non altro.
//
//  MODALITA' A — "Ichimoku come filtro + regime":
//    - Bias: prezzo sopra/sotto la NUVOLA (Kumo) -> long-only / short-only
//    - Regime: ADX > soglia  E  volatilita' sopra la media (bande in
//      espansione) -> tratta SOLO in trend, sta fuori nel laterale
//    - Trigger: incrocio Tenkan/Kijun (TK cross) nel verso del bias
//
//  MODALITA' B — "EMA 9/21 + candele Heikin Ashi" (quella che proponevi):
//    - Filtro trend: EMA9 sopra/sotto EMA21
//    - Trigger: la candela Heikin Ashi CAMBIA COLORE nel verso del trend
//    - NB: nessun filtro di regime (e' proprio il punto: vediamo se
//      entra nei range e si fa frustare)
//
//  USO: grafico XAUUSD, timeframe M15 (o quello che usi). Metti il
//  range dati su ESTESO/Tutto, poi usa gli input "Periodo" per tagliare
//  in-sample vs out-of-sample. Confronta i due Profit Factor.
// =====================================================================
strategy("Confronto Ichimoku vs EMA+HA - Claudio", overlay=true,
     initial_capital=12817,
     default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.30,
     slippage=2)
// Costo: 0.30 valuta per contratto per fill ~ spread realistico oro.
// NON usare commissione "Percentuale" nel pannello.

// ----------------- SCELTA MODALITA' ---------------------------------
mode = input.string("A: Ichimoku filtro + regime", "MODALITA' DA TESTARE",
     options=["A: Ichimoku filtro + regime", "B: EMA9/21 + Heikin Ashi"],
     group="== SCEGLI QUI ==")

// ----------------- INPUT comuni -------------------------------------
sess     = input.session("1300-1800", "Sessione operativa (CET)", group="Comune")
useSess  = input.bool(true, "Filtro sessione", group="Comune")
atrLen   = input.int(14, "ATR period (SL/TP)", group="Comune")
atrMult  = input.float(1.5, "SL = ATR x", step=0.1, group="Comune")
tpMult   = input.float(3.0, "TP = ATR x", step=0.1, group="Comune",
     tooltip="RR = TP/SL. Default 3.0/1.5 = 1:2.")
riskPct  = input.float(1.0, "Rischio % per trade", step=0.25, group="Comune")
closeEOD = input.bool(true, "Chiudi a fine sessione (intraday)", group="Comune")

// ----------------- INPUT Modalita' A --------------------------------
tenkanLen = input.int(9,  "Tenkan", group="A) Ichimoku")
kijunLen  = input.int(26, "Kijun",  group="A) Ichimoku")
spanBLen  = input.int(52, "Senkou B", group="A) Ichimoku")
adxLen    = input.int(14, "ADX length", group="A) Regime")
adxThr    = input.float(20, "ADX soglia (trend valido)", group="A) Regime")
bbLen     = input.int(20, "Bollinger length (volatilita')", group="A) Regime")
useVolExp = input.bool(true, "Richiedi volatilita' sopra la media", group="A) Regime")

// ----------------- INPUT Modalita' B --------------------------------
fastLen = input.int(9,  "EMA veloce", group="B) EMA+HA")
slowLen = input.int(21, "EMA lenta",  group="B) EMA+HA")

// ----------------- INPUT Periodo (in/out-of-sample) -----------------
useDates = input.bool(false, "Limita periodo", group="Periodo",
     tooltip="Accendi per testare un sotto-periodo. Tieni ESTESO su Tutto.")
sY = input.int(2026, "Inizio anno",  group="Periodo")
sM = input.int(1,    "Inizio mese",  minval=1, maxval=12, group="Periodo")
sD = input.int(1,    "Inizio giorno",minval=1, maxval=31, group="Periodo")
eY = input.int(2026, "Fine anno",    group="Periodo")
eM = input.int(12,   "Fine mese",    minval=1, maxval=12, group="Periodo")
eD = input.int(31,   "Fine giorno",  minval=1, maxval=31, group="Periodo")
startD  = timestamp(syminfo.timezone, sY, sM, sD, 0, 0)
endD    = timestamp(syminfo.timezone, eY, eM, eD, 23, 59)
inRange = not useDates or (time >= startD and time <= endD)

// ----------------- CALCOLI comuni -----------------------------------
atr    = ta.atr(atrLen)
inSess = not useSess or not na(time(timeframe.period, sess))

// ================= MODALITA' A: Ichimoku + regime ===================
tenkan = (ta.highest(high, tenkanLen) + ta.lowest(low, tenkanLen)) / 2.0
kijun  = (ta.highest(high, kijunLen)  + ta.lowest(low, kijunLen))  / 2.0
leadA  = (tenkan + kijun) / 2.0
leadB  = (ta.highest(high, spanBLen) + ta.lowest(low, spanBLen)) / 2.0
// Nuvola AL BAR CORRENTE = valori proiettati 26 barre fa
cloudTop = math.max(leadA[kijunLen], leadB[kijunLen])
cloudBot = math.min(leadA[kijunLen], leadB[kijunLen])
biasLongA  = close > cloudTop
biasShortA = close < cloudBot

[dip, dim, adxv] = ta.dmi(adxLen, adxLen)
basis = ta.sma(close, bbLen)
dev   = ta.stdev(close, bbLen)
bbw   = (2 * dev) / basis                      // larghezza banda normalizzata
volExpOK = not useVolExp or bbw > ta.sma(bbw, bbLen)
regimeOK = adxv > adxThr and volExpOK

tkUp = ta.crossover(tenkan, kijun)
tkDn = ta.crossunder(tenkan, kijun)

longA  = biasLongA  and regimeOK and tkUp
shortA = biasShortA and regimeOK and tkDn

// ================= MODALITA' B: EMA9/21 + Heikin Ashi ===============
ema9  = ta.ema(close, fastLen)
ema21 = ta.ema(close, slowLen)
haClose = (open + high + low + close) / 4.0
var float haOpen = na
haOpen := na(haOpen[1]) ? (open + close) / 2.0 : (haOpen[1] + haClose[1]) / 2.0
haBull = haClose >= haOpen
flipUp = haBull and not haBull[1]
flipDn = (not haBull) and haBull[1]

longB  = ema9 > ema21 and flipUp
shortB = ema9 < ema21 and flipDn

// ----------------- SELEZIONE segnale --------------------------------
isA = mode == "A: Ichimoku filtro + regime"
longSig  = (isA ? longA  : longB)  and inSess and inRange
shortSig = (isA ? shortA : shortB) and inSess and inRange

// ----------------- SIZING (1% del capitale) -------------------------
f_qty(stopDist) =>
    q = 1.0
    if stopDist > 0 and syminfo.pointvalue > 0
        q := (strategy.equity * riskPct / 100.0) / (stopDist * syminfo.pointvalue)
    q

// ----------------- INGRESSI / USCITE --------------------------------
sd = atr * atrMult
tp = atr * tpMult

if longSig and strategy.position_size == 0 and sd > 0
    strategy.entry("L", strategy.long, qty=f_qty(sd))
    strategy.exit("Lx", "L", stop=close - sd, limit=close + tp)

if shortSig and strategy.position_size == 0 and sd > 0
    strategy.entry("S", strategy.short, qty=f_qty(sd))
    strategy.exit("Sx", "S", stop=close + sd, limit=close - tp)

if closeEOD and useSess and not inSess and inSess[1]
    strategy.close_all(comment="EOD")

// ----------------- VISUAL -------------------------------------------
p1 = plot(isA ? cloudTop : na, "Kumo top", color=color.new(color.green, 70))
p2 = plot(isA ? cloudBot : na, "Kumo bot", color=color.new(color.red, 70))
fill(p1, p2, color=color.new(color.gray, 88), title="Nuvola")
plot(isA ? tenkan : ema9,  "Tenkan/EMA9",  color=color.new(color.blue, 0))
plot(isA ? kijun  : ema21, "Kijun/EMA21",  color=color.new(color.orange, 0))
bgcolor(isA and regimeOK ? color.new(color.teal, 92) : na, title="Regime ON (solo A)")

// etichetta diagnostica
if barstate.islast
    var label lab = na
    label.delete(lab)
    txt = "MODALITA': " + (isA ? "A (Ichimoku+regime)" : "B (EMA+HA)") +
         "\nTrade chiusi: " + str.tostring(strategy.closedtrades) +
         "\nProfit Factor: " + str.tostring(strategy.grossprofit / math.max(strategy.grossloss, 1), "#.##") +
         "\nNet: " + str.tostring(strategy.netprofit, "#.#")
    lab := label.new(bar_index, high, txt, style=label.style_label_down,
         color=color.navy, textcolor=color.white, size=size.normal)
