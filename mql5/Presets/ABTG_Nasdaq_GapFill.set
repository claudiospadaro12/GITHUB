InpBufferPoints=300
InpPendingExpiryMin=120
InpAllowLong=true
InpAllowShort=true
InpUseGapFill=true
InpGapMinPoints=3000
InpGapMinRR=1.5
InpUseEmaFilter=false
InpEmaFast=14
InpEmaSlow=200
InpFilterTF=16385
InpUseSupertrend=false
InpStAtrPeriod=10
InpStMultiplier=2.5
