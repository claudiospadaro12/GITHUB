; ABTG_ScalperDirezionale -- preset DEMO (manuale 50503635, C:\MT5_MANUALE). NON FTMO, NON reale 10105439.
; Modo MANUALE: verso dalla tua prima posizione a mano; target +3 EUR, stop -2 EUR, 10 s, lotto 0.01 -> +0.01 ogni 10 EUR, max 0.10.
; Modo TICK (25/09 sera): InpEntryMode=1, InpCandleRule=2, verso dal movimento degli ultimi 5 tick, minimo 1 punto.
; Modo CICLO (scelto da Claudio, 25/09 sera, "abbinarlo al cycle"): InpEntryMode=1, InpCandleRule=3, InpCicloRegola=0 (SEGNO):
;   opera nel colore dell'istogramma del Ciclo sull'ultima barra CHIUSA del TF InpCandleTF (1 = M1): verde = long, rosso = short.
;   InpCicloRegola=1 = INCROCIO: una sola operazione per incrocio dello zero. I nove numeri del ciclo sono quelli della fonte.
InpEntryMode=1
InpCandleTF=1
InpCandleRule=3
InpTickWindow=5
InpFirstMoveSeconds=3
InpFirstMovePoints=1.0
InpCicloRegola=0
InpCicloMinimo=0.0
InpK1Len=5
InpK1Smo=3
InpK2Len=14
InpK2Smo=3
InpK3Len=45
InpK3Smo=14
InpK4Len=75
InpK4Smo=20
InpMmLen=9
InpDirection=0
InpAutoStart=false
InpStopWhenManualClosed=true
InpTargetEuro=3.0
InpStopEuro=2.0
InpMaxSeconds=10
InpPauseMs=500
InpLotStart=0.01
InpLotStep=0.01
InpStepEveryEuro=10.0
InpLotMax=0.10
InpResetOnLoss=true
InpMaxLossSessionEuro=20.0
InpMaxConsecutiveLosses=3
InpMaxTradesPerMinute=6
InpMaxRequestsPerDay=500
InpStartHour=0
InpEndHour=24
InpMagic=779901
InpDeviationPts=50
InpVerbose=true
