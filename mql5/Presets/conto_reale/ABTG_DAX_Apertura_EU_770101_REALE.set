; ==============================================================
; PRESET CONTO REALE -- ABTG_DAX_Apertura_EU  (magic 770101)
; Simbolo: D30EUR   Timeframe del grafico: M5
; Unica differenza dalla cella viva sul conto piccolo/100k:
;   InpRiskPercent 1,0 -> 0,65 (taglia di casa per il conto reale).
; Orari in ORA SERVER BCM (= ora italiana - 1): DAX apre 08:00 server.
; Si carica dalla finestra input dell EA -> Carica...
; ==============================================================
; === Sessione (ORARIO DEL SERVER/BROKER!) ====
InpSessionHour=8
InpSessionMin=0
InpRangeMinutes=35
InpCloseHour=17
InpCloseMin=30
InpCloseAtEnd=true
InpOneTradePerDay=true
InpMaxPosSimbolo=0
; === Ingresso ====
InpEntryMode=2
InpRangeMode=0
InpLevelTF=16385
InpPrevWindowMin=60
InpBufferPoints=500.0
InpOCTimeframe=0
InpPendingExpiryMin=120
InpAllowLong=true
InpAllowShort=false
InpMinRangePts=0.0
InpMaxRangePts=0.0
; === Retest (InpEntryMode=RETEST, leva Emiliano) ====
InpRetestOffsetPts=200.0
InpFadeOffsetPts=0.0
; === Entrata ritardata/confermata (InpEntryMode=DELAYED) ====
InpDelayMinutes=30
InpDelayDirMode=0
; === Gap Fill (opzionale, tipico USA) ====
InpUseGapFill=false
InpGapMinPoints=150.0
InpGapMinRR=1.5
; === Filtro di trend (opzionale) ====
InpUseEmaFilter=false
InpEmaFast=14
InpEmaSlow=200
InpFilterTF=16385
InpUseSupertrend=false
InpStAtrPeriod=10
InpStMultiplier=2.5
InpStTF=16385
InpUseSupertrend3=false
; === Filtro di correlazione (opzionale) ====
InpUseCorrelation=false
InpCorrSymbol=SPXUSD
InpCorrTF=16385
InpCorrEmaFast=14
InpCorrEmaSlow=100
; === Filtro VWAP (live Emiliano, opt-in) ====
InpUseVwapFilter=false
InpVwapTF=15
; === Rischio e gestione ====
InpRiskPercent=0.65
InpSLMode=0
InpAtrSlMult=1.5
InpAtrPeriodMgmt=14
InpTP1_R=1.0
InpTP1_ClosePct=0.0
InpBreakevenAtTP1=true
InpBEatR=0.0
InpUseTrailing=true
InpTrailStartR=0.0
InpTrailMode=1
InpTrailTF=5
InpTrailAtrMult=2.0
InpTrailFixedPts=410.0
; === Obiettivi a numeri tondi (approx. Multipivot/%Custom) ====
InpUseRoundLevels=false
InpRoundStep=100.0
InpRoundMinDistPts=50.0
; === Filtro notizie (file CSV in MQL5/Files) ====
InpUseNewsFilter=false
InpNewsFile=abtg_news.csv
InpNewsMinImpact=3
InpNewsBeforeMin=30
InpNewsAfterMin=30
InpNewsShiftMinutes=0
InpNewsCurrencies=
InpNewsFlatten=true
; === Slippage & floor SL (consiglio amico) ====
InpSlippagePts=0.0
InpMinStopPts=0.0
InpSkipIfTight=true
; === Filtro VOLUMI (regola Emiliano: rottura valida solo con volumi) ===
InpUseVolumeFilter=false
InpVolMult=1.5
InpVolAvgBars=20
InpUseAtrFilter=false
InpAtrFilterBars=20
InpAtrFilterMult=1.0
InpConfirmMode=0
; === Generali ====
InpMagic=770101
InpMaxSpread=0
InpVerbose=true

; --------------------------------------------------------------
; 14/09: FIRMA r137c (Claudio). InpTP1_ClosePct 50 -> 0.
;   LA MISURA
;        PF  OOS 1,39709 -> 1,49140   DD OOS 7,2328% -> 6,2719%
;        PF  IS  1,12634 -> 1,18323   DD IS  5,4362% -> 4,9576%
;        A PARITA' DI POSIZIONI: 193 in OOS e 132 in IS nelle due
;        celle. ATTENZIONE leggendo i CSV: la colonna "Trades"
;        conta i DEAL, quindi mostra 270 -> 193 (OOS) e 175 -> 132
;        (IS). Non e' una perdita di operazioni: la parziale
;        spezzava una posizione in due deal. Il conteggio per
;        POSIZIONE e' fatto sui per-trade (position_id distinti).
;   LE FONTI
;        backtest_pipeline/prove/R137c_parziale_770101_D30EUR.txt
;        risultati_prove/dal_vps/ABTG_DAX_Apertura_EU/
;          ABTG_DAX_Apertura_EU_D30EUR_{IS,OOS}_r137c.csv
;        report/PIANO_PROP.md riga L1.
;        Questo preset e' la cella misurata su 82 input su 82: le
;        uniche due differenze sono InpRiskPercent 1,0 -> 0,65
;        (taglia del conto reale) e InpMagic 786201 -> 770101.
;   IL MECCANISMO -- letto sul sorgente, non dedotto
;        a) a ClosePct=0 il blocco della parziale (r.1899 di
;           ABTG_DAX_Apertura_EU.mq5: if(!partialDone &&
;           InpTP1_ClosePct > 0 && InpTP1_ClosePct < 100)) non
;           entra MAI;
;        b) InpBreakevenAtTP1 (r.1931) e' ANNIDATO dentro quel
;           blocco: quindi smette di scattare anche il breakeven
;           al 1o obiettivo, non solo la chiusura parziale.
;           InpBreakevenAtTP1=true qui sotto resta scritto perche'
;           e' identico alla cella misurata, ma e' INERTE;
;        c) InpBEatR=0 lascia spento anche il breakeven
;           INDIPENDENTE (r.1945, attivo solo se > 0), in tutte e
;           due le celle: nessun altro breakeven sostituisce
;           quello perso;
;        d) resta il TRAILING (r.1981), che e' FUORI da quel
;           blocco e con InpTrailStartR=0 e' ARMATO dal primo
;           tick. MA "armato" NON vuol dire "coperto": con
;           InpTrailMode=1 (= PREVBAR) lo stop si sposta solo
;           quando il MINIMO della candela M5 precedente sta
;           SOPRA il prezzo d'ingresso (r.1986: newSL > sl &&
;           newSL > openP). Fino a quel momento la posizione
;           resta allo STOP INIZIALE PIENO.
;           InpTrailFixedPts=410 NON si applica: vale solo con
;           InpTrailMode=2 (FIXED). E' scritto sotto perche' e'
;           nella cella misurata, ma qui e' inerte.
;   IN UNA RIGA: si scambia il breakeven a 1R con il trailing di
;        struttura. Nella prima fase del trade il rischio per
;        operazione e' PIU' ALTO, e i CSV hanno misurato lo stesso
;        un DD piu' BASSO in tutte e due le finestre. Il numero
;        vince sull'intuizione, ma il meccanismo va saputo.
; --------------------------------------------------------------
; 06/09: input dell EA che il preset NON copriva. Il valore qui
;        scritto e IDENTICO al default compilato, quindi il
;        comportamento non cambia di una virgola: cambia che ora
;        il file li DICHIARA, invece di lasciarli al default
;        (e il default silenzioso e esattamente la trappola del
;        2% chiusa il 02/09, verbale VERBALE_CHIUSURA_770101).
; --------------------------------------------------------------
; R51 secondo ciclo sul lato opposto: default compilato false
InpAllowReverse=false
; Guardian: default compilato true. Sul conto REALE il Guardian NON gira: la guardia e fail-open (canale inesistente = passa), quindi qui vale come no-op dichiarato.
InpUsaGuardian=true
