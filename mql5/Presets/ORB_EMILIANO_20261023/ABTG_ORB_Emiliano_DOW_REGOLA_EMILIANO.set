InpNewsMinImpact=3
InpNewsBeforeMin=30
InpNewsAfterMin=30
InpNewsShiftMinutes=0
InpNewsCurrencies=USD
InpNewsFlatten=true
InpComment=ORB OTT
InpMagic=770631
InpMaxSpread=0
InpVerbose=true
