; Preset DAX LIVE 5m - logica della live applicata al DAX (candela 5 min pre-apertura)
; Candela 08:55-09:00 (IT) = 07:55-08:00 server; ordini a 7 punti.
; Filtro ampiezza candela OFF di default (taralo sul DAX dopo averlo osservato).
; Carica in: Strategy Tester -> tab Input -> Load (EA: ABTG_DAX_Live5m)
; BCM CONFERMATO: server = ora italiana - 1. DAX apre 09:00 IT = 08:00 server.
InpSessionHour=8
InpSessionMin=0
InpRangeMinutes=15
InpCloseHour=17
InpCloseMin=30
InpCloseAtEnd=true
InpOneTradePerDay=true
InpEntryMode=0
InpRangeMode=1
InpLevelTF=16385
InpPrevWindowMin=5
InpBufferPoints=700
InpPendingExpiryMin=120
InpAllowLong=true
InpAllowShort=true
InpMinRangePts=0
InpMaxRangePts=0
InpUseGapFill=false
InpGapMinPoints=3000
InpGapMinRR=1.5
InpUseEmaFilter=false
InpEmaFast=14
InpEmaSlow=200
InpFilterTF=16385
InpUseSupertrend=false
InpStAtrPeriod=10
InpStMultiplier=2.5
InpStTF=16385
InpUseCorrelation=false
InpCorrSymbol=SPXUSD
InpCorrTF=16385
InpCorrEmaFast=14
InpCorrEmaSlow=100
InpRiskPercent=2.0
InpSLMode=0
InpAtrSlMult=1.5
InpAtrPeriodMgmt=14
InpTP1_R=1.0
InpTP1_ClosePct=50.0
InpBreakevenAtTP1=true
InpUseTrailing=true
InpTrailMode=1
InpTrailTF=5
InpTrailAtrMult=2.0
InpTrailFixedPts=2000
InpUseRoundLevels=false
InpRoundStep=50.0
InpRoundMinDistPts=300
InpUseNewsFilter=false
InpNewsFile=abtg_news.csv
InpNewsMinImpact=3
InpNewsBeforeMin=30
InpNewsAfterMin=30
