InpAdrDistMax=0.8
InpOrder1Atr=0.2
InpOrder2Atr=0.3
InpUseOrder2=true
InpPendingExpiryBars=6
InpSLatr=1.0
InpMinRR=1.0
InpTP_RR=2.0
InpTP1_ATRmult=0.0
InpTP1Pct=50.0
InpBreakeven=true
InpUseTrailing=true
InpUseCutoff=false
